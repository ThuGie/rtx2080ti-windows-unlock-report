diff --git a/GpuUnlockPkg/Application/Loader/Pci.c b/GpuUnlockPkg/Application/Loader/Pci.c
index d45b727..f9666c4 100644
--- a/GpuUnlockPkg/Application/Loader/Pci.c
+++ b/GpuUnlockPkg/Application/Loader/Pci.c
@@ -4,6 +4,260 @@
 #include "TuPci.h"
 
 #include <IndustryStandard/Pci.h>
+#include <Protocol/GraphicsOutput.h>
+#include <Protocol/LoadedImage.h>
+#include <Protocol/DriverBinding.h>
+#include <Protocol/SimpleTextOut.h>
+#include <Library/DevicePathLib.h>
+
+STATIC EFI_HANDLE mReleasedPci;
+STATIC BOOLEAN mDisplayReleased;
+STATIC BOOLEAN mDisplayPreserved;
+STATIC EFI_PCI_IO_PROTOCOL *mReleasedIo;
+STATIC UINT8 mReleasedBar;
+
+STATIC EFI_STATUS
+FindPinnedOwner (EFI_HANDLE Controller, EFI_GUID *Protocol, CONST CHAR16 *Path,
+                 UINT64 Size, UINT32 Version, UINTN StopOffset, EFI_HANDLE *Owner)
+{
+  EFI_OPEN_PROTOCOL_INFORMATION_ENTRY *Entries = NULL;
+  UINTN Count = 0, Index, Found = 0;
+  EFI_STATUS Status = gBS->OpenProtocolInformation (Controller, Protocol, &Entries, &Count);
+  if (EFI_ERROR (Status)) return Status;
+  *Owner = NULL;
+  for (Index = 0; Index < Count; Index++) {
+    EFI_DRIVER_BINDING_PROTOCOL *Binding = NULL;
+    EFI_LOADED_IMAGE_PROTOCOL *Image = NULL;
+    CHAR16 *Actual;
+    if (!(Entries[Index].Attributes & EFI_OPEN_PROTOCOL_BY_DRIVER)) continue;
+    Found++;
+    Status = gBS->HandleProtocol (Entries[Index].AgentHandle,
+                                  &gEfiDriverBindingProtocolGuid, (VOID **)&Binding);
+    if (EFI_ERROR (Status) || Binding == NULL || Binding->Version != Version) break;
+    Status = gBS->HandleProtocol (Binding->ImageHandle,
+                                  &gEfiLoadedImageProtocolGuid, (VOID **)&Image);
+    if (EFI_ERROR (Status) || Image == NULL || Image->ImageSize != Size ||
+        Image->ImageCodeType != EfiBootServicesCode ||
+        (UINTN)Binding->Stop != (UINTN)Image->ImageBase + StopOffset) break;
+    Actual = ConvertDevicePathToText (Image->FilePath, FALSE, FALSE);
+    if (Actual == NULL) break;
+    if (StrCmp (Actual, Path) == 0) *Owner = Entries[Index].AgentHandle;
+    FreePool (Actual);
+  }
+  FreePool (Entries);
+  return Found == 1 && *Owner != NULL ? EFI_SUCCESS : EFI_UNSUPPORTED;
+}
+
+STATIC BOOLEAN NoDriverOwner (EFI_HANDLE Handle, EFI_GUID *Protocol)
+{
+  EFI_OPEN_PROTOCOL_INFORMATION_ENTRY *Entries = NULL;
+  UINTN Count = 0, Index;
+  EFI_STATUS Status = gBS->OpenProtocolInformation (Handle, Protocol, &Entries, &Count);
+  if (EFI_ERROR (Status)) return Status == EFI_NOT_FOUND || Status == EFI_UNSUPPORTED;
+  for (Index = 0; Index < Count; Index++) {
+    if (Entries[Index].Attributes & EFI_OPEN_PROTOCOL_BY_DRIVER) {
+      FreePool (Entries);
+      return FALSE;
+    }
+  }
+  if (Entries != NULL) FreePool (Entries);
+  return TRUE;
+}
+
+EFI_STATUS TuPciReleaseDisplay (EFI_HANDLE ImageHandle, TU_PCI_GPU *Gpus, UINTN Count, BOOLEAN Preserve)
+{
+  EFI_HANDLE *Gops = NULL, NvOwner, GfxOwner, TextOwner, Gop;
+  UINTN GopCount = 0;
+  EFI_STATUS Status;
+  EFI_PCI_IO_PROTOCOL *Claim = NULL;
+  UINT32 Subsystem = 0;
+  if (Count != 1 || Gpus[0].DeviceId != 0x1e07 || Gpus[0].Segment != 0 ||
+      Gpus[0].Bus != 1 || Gpus[0].Device != 0 || Gpus[0].Function != 0) return EFI_UNSUPPORTED;
+  Status = Gpus[0].PciIo->Pci.Read (Gpus[0].PciIo, EfiPciIoWidthUint32, 0x2c, 1, &Subsystem);
+  if (EFI_ERROR (Status) || Subsystem != 0x866a1043) return EFI_UNSUPPORTED;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiGraphicsOutputProtocolGuid, NULL, &GopCount, &Gops);
+  if (EFI_ERROR (Status)) return Status;
+  if (GopCount != 1) { FreePool (Gops); return EFI_UNSUPPORTED; }
+  Gop = Gops[0];
+  FreePool (Gops);
+  Status = FindPinnedOwner (Gpus[0].Handle, &gEfiPciIoProtocolGuid,
+                            L"nvgop-tu1xx", 133696, 0x50009, 0x2888, &NvOwner);
+  if (EFI_ERROR (Status)) return Status;
+  Status = FindPinnedOwner (Gop, &gEfiGraphicsOutputProtocolGuid,
+                            L"FvFile(43E7ABDD-E352-4CFB-A230-4CDC1D350E5C)",
+                            21696, 0x10, 0x9dc, &GfxOwner);
+  if (EFI_ERROR (Status)) return Status;
+  Status = FindPinnedOwner (Gop, &gEfiSimpleTextOutProtocolGuid,
+                            L"FvFile(628A497D-2BF6-4264-8741-069DBD3399D6)",
+                            25856, 0x10, 0x12cc, &TextOwner);
+  if (EFI_ERROR (Status)) return Status;
+  if (Preserve) {
+  TuPrint (L"Testing normal finalization with native GOP ownership preserved.\r\n");
+  GU_NOTE ("display comparison: preserve verified native GOP owners; console callbacks silenced\n");
+  TuLogFlush ();
+  TuLogSilenceDisplay ();
+  mReleasedPci = Gpus[0].Handle;
+  mReleasedIo = Gpus[0].PciIo;
+  mReleasedBar = Gpus[0].BarIndex;
+  mDisplayPreserved = TRUE;
+  return EFI_SUCCESS;
+  }
+  TuPrint (L"Releasing verified firmware display drivers. Screen may freeze until Windows.\r\n");
+  GU_NOTE ("display release preflight passed: ASUS 1e07/866a, native GOP pinned\n");
+  TuLogFlush ();
+  TuLogSilenceDisplay ();
+  GU_NOTE ("display release intent: disconnect text owner\n");
+  TuLogFlush ();
+  Status = gBS->DisconnectController (Gop, TextOwner, NULL);
+  GU_NOTE ("display release text status=%lx\n", (UINT64)Status);
+  TuLogFlush ();
+  if (EFI_ERROR (Status) || !NoDriverOwner (Gop, &gEfiSimpleTextOutProtocolGuid)) return EFI_DEVICE_ERROR;
+  GU_NOTE ("display release intent: disconnect graphics owner\n");
+  TuLogFlush ();
+  Status = gBS->DisconnectController (Gop, GfxOwner, NULL);
+  GU_NOTE ("display release graphics status=%lx\n", (UINT64)Status);
+  TuLogFlush ();
+  if (EFI_ERROR (Status) || !NoDriverOwner (Gop, &gEfiGraphicsOutputProtocolGuid)) return EFI_DEVICE_ERROR;
+  GU_NOTE ("display release intent: disconnect NVIDIA GOP owner\n");
+  TuLogFlush ();
+  Status = gBS->DisconnectController (Gpus[0].Handle, NvOwner, NULL);
+  GU_NOTE ("display release nvgop status=%lx\n", (UINT64)Status);
+  TuLogFlush ();
+  if (EFI_ERROR (Status) || !NoDriverOwner (Gpus[0].Handle, &gEfiPciIoProtocolGuid)) return EFI_DEVICE_ERROR;
+  Status = gBS->OpenProtocol (Gpus[0].Handle, &gEfiPciIoProtocolGuid, (VOID **)&Claim,
+                              ImageHandle, Gpus[0].Handle, EFI_OPEN_PROTOCOL_BY_DRIVER | EFI_OPEN_PROTOCOL_EXCLUSIVE);
+  GU_NOTE ("display exclusive PCI claim status=%lx\n", (UINT64)Status);
+  TuLogFlush ();
+  if (EFI_ERROR (Status) || Claim != Gpus[0].PciIo) return EFI_DEVICE_ERROR;
+  mReleasedPci = Gpus[0].Handle;
+  mReleasedIo = Gpus[0].PciIo;
+  mReleasedBar = Gpus[0].BarIndex;
+  mDisplayReleased = TRUE;
+  return EFI_SUCCESS;
+}
+
+BOOLEAN TuPciDisplayReadyForWindows (VOID)
+{
+  EFI_HANDLE *Gops = NULL;
+  UINTN Count = 0;
+  UINT16 Command = 0xffff;
+  EFI_STATUS Status;
+  if (!mDisplayReleased && !mDisplayPreserved) return TRUE;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiGraphicsOutputProtocolGuid, NULL, &Count, &Gops);
+  if (Gops != NULL) FreePool (Gops);
+  if (mDisplayReleased && (Status != EFI_NOT_FOUND || Count != 0 ||
+      !NoDriverOwner (mReleasedPci, &gEfiPciIoProtocolGuid))) return FALSE;
+  if (mDisplayPreserved && (EFI_ERROR (Status) || Count != 1)) return FALSE;
+  Status = mReleasedIo->Pci.Read (mReleasedIo, EfiPciIoWidthUint16, 4, 1, &Command);
+  if (EFI_ERROR (Status) || (Command & 4) || !(Command & 2)) return FALSE;
+  return TuPciMemRead32 (mReleasedIo, mReleasedBar, TU_TURING_FEAT_SS0) == TU_SS0_FULL &&
+         TuPciMemRead32 (mReleasedIo, mReleasedBar, TU_TURING_FEAT_SS1) == TU_SS1_FULL &&
+         TuPciMemRead32 (mReleasedIo, mReleasedBar, TU_TURING_FEAT_READOUT) == 0;
+}
+
+EFI_STATUS TuPciFinishDisplay (EFI_HANDLE ImageHandle, TU_PCI_GPU *Gpus, UINTN Count)
+{
+  EFI_HANDLE *Gops = NULL;
+  UINTN GopCount = 0;
+  EFI_STATUS Status;
+  if (mDisplayPreserved && Count == 1 && Gpus[0].Handle == mReleasedPci) {
+    return TuPciDisplayReadyForWindows () ? EFI_SUCCESS : EFI_DEVICE_ERROR;
+  }
+  if (!mDisplayReleased || Count != 1 || Gpus[0].Handle != mReleasedPci) return EFI_NOT_READY;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiGraphicsOutputProtocolGuid, NULL, &GopCount, &Gops);
+  if (Gops != NULL) FreePool (Gops);
+  if (Status != EFI_NOT_FOUND || GopCount != 0) return EFI_ACCESS_DENIED;
+  Status = gBS->CloseProtocol (mReleasedPci, &gEfiPciIoProtocolGuid, ImageHandle, mReleasedPci);
+  if (EFI_ERROR (Status) || !NoDriverOwner (mReleasedPci, &gEfiPciIoProtocolGuid)) return EFI_DEVICE_ERROR;
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+CaptureOwners (EFI_HANDLE Handle, EFI_GUID *Protocol, CONST CHAR8 *Kind)
+{
+  EFI_OPEN_PROTOCOL_INFORMATION_ENTRY *Entries = NULL;
+  UINTN Count = 0;
+  UINTN Index;
+  EFI_STATUS Status;
+
+  Status = gBS->OpenProtocolInformation (Handle, Protocol, &Entries, &Count);
+  GU_NOTE ("ownership kind=%a handle=%p status=%lx entries=%u\n",
+           Kind, Handle, (UINT64)Status, (unsigned)Count);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+  for (Index = 0; Index < Count; Index++) {
+    EFI_LOADED_IMAGE_PROTOCOL *Image = NULL;
+    EFI_DRIVER_BINDING_PROTOCOL *Binding = NULL;
+    EFI_HANDLE ImageHandle = Entries[Index].AgentHandle;
+    CHAR16 *WidePath;
+    CHAR8 Path[512];
+
+    GU_NOTE ("ownership entry agent=%p controller=%p attributes=%#x count=%u\n",
+             Entries[Index].AgentHandle, Entries[Index].ControllerHandle,
+             Entries[Index].Attributes, Entries[Index].OpenCount);
+    Status = gBS->HandleProtocol (Entries[Index].AgentHandle,
+                                 &gEfiDriverBindingProtocolGuid, (VOID **)&Binding);
+    if (!EFI_ERROR (Status) && Binding != NULL) {
+      ImageHandle = Binding->ImageHandle;
+      GU_NOTE ("ownership binding agent=%p image=%p version=%#x stop=%p\n",
+               Entries[Index].AgentHandle, ImageHandle, Binding->Version, Binding->Stop);
+    }
+    Status = gBS->HandleProtocol (ImageHandle,
+                                 &gEfiLoadedImageProtocolGuid, (VOID **)&Image);
+    if (!EFI_ERROR (Status) && Image != NULL) {
+      GU_NOTE ("ownership image agent=%p base=%p size=%llu code_type=%u\n",
+               Entries[Index].AgentHandle, Image->ImageBase, Image->ImageSize,
+               (unsigned)Image->ImageCodeType);
+      WidePath = ConvertDevicePathToText (Image->FilePath, FALSE, FALSE);
+      if (WidePath != NULL) {
+        if (StrLen (WidePath) < sizeof (Path) &&
+            !EFI_ERROR (UnicodeStrToAsciiStrS (WidePath, Path, sizeof (Path)))) {
+          GU_NOTE ("ownership image_path=%a\n", Path);
+        }
+        FreePool (WidePath);
+      }
+    }
+  }
+  if (Entries != NULL) {
+    FreePool (Entries);
+  }
+}
+
+VOID
+TuPciCaptureDisplayOwners (IN TU_PCI_GPU *Gpus, IN UINTN Count)
+{
+  EFI_HANDLE *Handles = NULL;
+  UINTN HandleCount = 0;
+  UINTN Index;
+  EFI_STATUS Status;
+
+  GU_NOTE ("ownership capture v2-native-20261027: read-only, no disconnects\n");
+  for (Index = 0; Index < Count; Index++) {
+    CaptureOwners (Gpus[Index].Handle, &gEfiPciIoProtocolGuid, "GPU-PCI");
+  }
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiGraphicsOutputProtocolGuid,
+                                   NULL, &HandleCount, &Handles);
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < HandleCount; Index++) {
+      CaptureOwners (Handles[Index], &gEfiGraphicsOutputProtocolGuid, "GOP");
+    }
+    FreePool (Handles);
+  }
+  GU_NOTE ("ownership capture end GOP_count=%u\n", (unsigned)HandleCount);
+  Handles = NULL;
+  HandleCount = 0;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleTextOutProtocolGuid,
+                                   NULL, &HandleCount, &Handles);
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < HandleCount; Index++) {
+      CaptureOwners (Handles[Index], &gEfiSimpleTextOutProtocolGuid, "TEXT-OUT");
+    }
+    FreePool (Handles);
+  }
+  TuLogFlush ();
+}
 
 BOOLEAN
 TuPciIsSupportedDeviceId (
